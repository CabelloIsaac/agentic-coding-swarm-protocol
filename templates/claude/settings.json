{
  "$comment": "Template for .claude/settings.json (versioned). Adjust paths and commands. deny rules apply to everyone; allow rules wait for each person's trust dialog.",
  "worktree": { "baseRef": "head" },
  "permissions": {
    "allow": [
      "Bash(pnpm verify *)",
      "Bash(pnpm vitest run *)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm wt:status *)",
      "Bash(pnpm wt:commit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(pnpm land *)",
      "Bash(pnpm wt:archive *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/secrets/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/dev/wt.ts\" setup", "timeout": 180 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/dev/wt.ts\" wip", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *vitest.config.ts|*biome.json|*architecture.test.ts|*docs.test.ts|*scripts/dev/land.ts|*scripts/dev/verify.ts|*.githooks/*) echo \"Warning: you are touching a quality gate ($f). Explain why in the commit; never relax it to make something pass.\" >&2 ;; esac; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
