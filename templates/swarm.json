{
  "protocol": "swarm",
  "version": "0.4.0",
  "level": 0,
  "integrationBranch": "main",
  "commands": {
    "setup": "corepack enable && pnpm install --frozen-lockfile",
    "verify": "pnpm verify",
    "verifyQuick": "pnpm verify --quick",
    "commit": "pnpm wt:commit",
    "status": "pnpm wt:status",
    "land": "pnpm land",
    "newAdr": "docs/adr/draft-<slug>.md",
    "audit": "pnpm audit:repo",
    "ratchets": "node scripts/dev/ratchets.ts",
    "findings": "node scripts/dev/findings.ts"
  },
  "hooks": {
    "sessionStart": "node scripts/dev/wt.ts setup",
    "stop": "node scripts/dev/wt.ts wip"
  },
  "findings": {
    "file": "docs/audits/findings.jsonl",
    "sla": {
      "high": 2,
      "medium": 14,
      "low": 60
    },
    "closureEvery": 3
  },
  "roadmap": {
    "maxActive": 12,
    "staleDays": 14
  },
  "gates": [],
  "review": {
    "mode": "sensitive",
    "sensitive": [
      "**/auth/**",
      "**/*auth*.*",
      "**/session*/**",
      "**/payments/**",
      "**/billing/**",
      "**/migrations/**",
      "*.sql",
      ".github/**",
      ".githooks/**",
      ".claude/**",
      "swarm.json",
      "scripts/dev/**",
      "**/vitest.config.*",
      "**/architecture.test.*",
      "**/docs.test.*",
      "biome.json",
      "quality-ratchets.json",
      "pnpm-lock.yaml"
    ]
  }
}
